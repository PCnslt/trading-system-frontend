{
  "name": "trading-agents",
  "description": "10-agent trading system with Docker MCP",
  "version": "1.0.0",
  "servers": [
    {
      "name": "technical-analyst",
      "type": "docker",
      "image": "technical-analyst:latest",
      "environment": {
        "ALPHA_VANTAGE_KEY": "${DOCKER_MCP_SECRET_ALPHA_VANTAGE_KEY}"
      },
      "resources": {
        "cpu": 1,
        "memory": "2GB"
      }
    },
    {
      "name": "fundamental-analyst",
      "type": "docker",
      "image": "fundamental-analyst:latest",
      "environment": {
        "ALPHA_VANTAGE_KEY": "${DOCKER_MCP_SECRET_ALPHA_VANTAGE_KEY}",
        "FMP_API_KEY": "${DOCKER_MCP_SECRET_FMP_API_KEY}"
      },
      "resources": {
        "cpu": 1,
        "memory": "2GB"
      }
    },
    {
      "name": "sentiment-analyst",
      "type": "docker",
      "image": "sentiment-analyst:latest",
      "environment": {
        "NEWSAPI_KEY": "${DOCKER_MCP_SECRET_NEWSAPI_KEY}",
        "TWITTER_BEARER_TOKEN": "${DOCKER_MCP_SECRET_TWITTER_BEARER_TOKEN}"
      },
      "resources": {
        "cpu": 1,
        "memory": "2GB"
      }
    },
    {
      "name": "macro-analyst",
      "type": "docker",
      "image": "macro-analyst:latest",
      "environment": {
        "FRED_API_KEY": "${DOCKER_MCP_SECRET_FRED_API_KEY}",
        "OECD_API_KEY": "${DOCKER_MCP_SECRET_OECD_API_KEY}"
      },
      "resources": {
        "cpu": 1,
        "memory": "2GB"
      }
    },
    {
      "name": "crypto-analyst",
      "type": "docker",
      "image": "crypto-analyst:latest",
      "environment": {
        "COINMARKETCAP_API_KEY": "${DOCKER_MCP_SECRET_COINMARKETCAP_API_KEY}",
        "BINANCE_API_KEY": "${DOCKER_MCP_SECRET_BINANCE_API_KEY}"
      },
      "resources": {
        "cpu": 1,
        "memory": "2GB"
      }
    },
    {
      "name": "options-analyst",
      "type": "docker",
      "image": "options-analyst:latest",
      "environment": {
        "OPTIONS_DATA_API_KEY": "${DOCKER_MCP_SECRET_OPTIONS_DATA_API_KEY}"
      },
      "resources": {
        "cpu": 1,
        "memory": "2GB"
      }
    },
    {
      "name": "risk-analyst",
      "type": "docker",
      "image": "risk-analyst:latest",
      "environment": {
        "RISK_MODEL_API_KEY": "${DOCKER_MCP_SECRET_RISK_MODEL_API_KEY}"
      },
      "volumes": [
        {
          "source": "portfolio-data",
          "target": "/app/portfolio",
          "readOnly": false
        }
      ],
      "resources": {
        "cpu": 1,
        "memory": "2GB"
      }
    },
    {
      "name": "quant-analyst",
      "type": "docker",
      "image": "quant-analyst:latest",
      "environment": {
        "QUANT_MODEL_API_KEY": "${DOCKER_MCP_SECRET_QUANT_MODEL_API_KEY}"
      },
      "resources": {
        "cpu": 2,
        "memory": "4GB"
      }
    },
    {
      "name": "sector-analyst",
      "type": "docker",
      "image": "sector-analyst:latest",
      "environment": {
        "SECTOR_DATA_API_KEY": "${DOCKER_MCP_SECRET_SECTOR_DATA_API_KEY}"
      },
      "resources": {
        "cpu": 1,
        "memory": "2GB"
      }
    },
    {
      "name": "compliance-analyst",
      "type": "docker",
      "image": "compliance-analyst:latest",
      "environment": {
        "REGULATORY_API_KEY": "${DOCKER_MCP_SECRET_REGULATORY_API_KEY}"
      },
      "volumes": [
        {
          "source": "regulations",
          "target": "/app/regulations",
          "readOnly": true
        }
      ],
      "resources": {
        "cpu": 1,
        "memory": "2GB"
      }
    }
  ],
  "tools": {
    "enabled": [
      "technical-analyst.calculate_rsi",
      "technical-analyst.calculate_macd",
      "technical-analyst.analyze_trend",
      "technical-analyst.generate_signal",
      "fundamental-analyst.analyze_fundamentals",
      "sentiment-analyst.analyze_sentiment",
      "macro-analyst.analyze_economic_indicators",
      "crypto-analyst.analyze_crypto",
      "options-analyst.analyze_options",
      "risk-analyst.calculate_risk",
      "quant-analyst.run_quant_model",
      "sector-analyst.analyze_sector",
      "compliance-analyst.check_compliance"
    ],
    "disabled": [
      "sentiment-analyst.twitter_scrape"  # Rate-limited API
    ]
  },
  "secrets": [
    "ALPHA_VANTAGE_KEY",
    "FMP_API_KEY",
    "NEWSAPI_KEY",
    "TWITTER_BEARER_TOKEN",
    "FRED_API_KEY",
    "OECD_API_KEY",
    "COINMARKETCAP_API_KEY",
    "BINANCE_API_KEY",
    "OPTIONS_DATA_API_KEY",
    "RISK_MODEL_API_KEY",
    "QUANT_MODEL_API_KEY",
    "SECTOR_DATA_API_KEY",
    "REGULATORY_API_KEY",
    "HUGGINGFACE_TOKEN",
    "OPENAI_API_KEY"
  ]
}