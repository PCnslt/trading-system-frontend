# Local Memory System - Environment Variables
# Created: 2026-03-31 07:08 EDT

# Database Configuration
DATABASE_URL=postgresql://memory_user:memory_password@postgres:5432/memory_system

# Ollama Configuration
OLLAMA_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
GENERATION_MODEL=llama3.2:3b

# Optional: External API Keys (for fallback)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# COHERE_API_KEY=...
# GROQ_API_KEY=...

# Budget Limits (USD)
DAILY_BUDGET=1.0
WEEKLY_BUDGET=5.0
ENFORCE_BUDGET_LIMITS=false

# Application Settings
LOG_LEVEL=INFO
API_DEBUG=false

# Security (change in production!)
SECRET_KEY=local-memory-system-dev-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS (for web frontend)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000